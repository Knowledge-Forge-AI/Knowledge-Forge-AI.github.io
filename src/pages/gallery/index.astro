---
import Site from '../../layouts/Site.astro';
import '../../styles/gallery.css';
import {
  galleryFacetOptions,
  galleryFacetValues,
  galleryRecords,
  type GenreBasis,
} from '../../data/gallery-records';

const labelMap: Readonly<Record<string, string>> = {
  'rei-ai': 'Rei Ai',
  shiori: 'Shiori',
  hikari: 'Hikari',
  orihime: 'Orihime',
  'knowledge-forge-ai': 'Knowledge Forge AI',
  'agentic-praxis-grimoire': 'Agentic Praxis Grimoire',
  'release-starport-9': 'Release Starport 9',
  'theme-forge': 'Theme Forge',
  'fantasy-cyberpunk-fusion': 'Fantasy/cyberpunk fusion',
  fantasy: 'Fantasy',
  'space-opera': 'Space opera',
  'not-recorded': 'Not recorded',
  'reference-inventory': 'Reference inventory',
  'source-date-not-recorded': 'Source date not recorded in this gallery',
  'conversion-date-not-recorded': 'Conversion date not recorded in this gallery',
  'historical-import': 'Historical import',
};

const labelFor = (value: string): string => {
  const known = labelMap[value];
  if (known) return known;
  if (value.startsWith('registry-recorded-')) {
    return `Registry record · ${value.slice('registry-recorded-'.length)}`;
  }
  if (value.startsWith('source-date-')) return `Source date · ${value.slice('source-date-'.length)}`;
  if (value.startsWith('conversion-date-')) return `Conversion date · ${value.slice('conversion-date-'.length)}`;
  return value;
};

const selectOptions = (values: readonly string[]) =>
  values.map((value) => ({ value, label: labelFor(value) }));

const genreBasisLabel = (basis: GenreBasis): string => {
  switch (basis) {
    case 'current-owner-source-fact':
      return 'Genre based on a current owner/source fact; generation settings not recorded.';
    case 'current-roadmap-fact':
      return 'Genre based on a current roadmap fact, not a generation parameter; generation settings not recorded.';
    case 'not-recorded':
      return 'Genre basis not recorded.';
    default: {
      const exhaustive: never = basis;
      return exhaustive;
    }
  }
};

const controls = [
  { name: 'character', label: 'Character', options: selectOptions(galleryFacetOptions.character) },
  { name: 'project', label: 'Project', options: selectOptions(galleryFacetOptions.project) },
  { name: 'genre', label: 'Genre', options: selectOptions(galleryFacetOptions.genre) },
  { name: 'styleRevision', label: 'Style revision', options: selectOptions(galleryFacetOptions.styleRevision) },
  { name: 'status', label: 'Status', options: selectOptions(galleryFacetOptions.status) },
  { name: 'date', label: 'Date', options: selectOptions(galleryFacetOptions.date) },
  { name: 'process', label: 'Process', options: selectOptions(galleryFacetOptions.process) },
] as const;

const recordCount = galleryRecords.length;
---

<Site
  title="Concept gallery"
  active="gallery"
  description="Meet Rei Ai, Orihime, Hikari, and Shiori through four early illustrations from the forge's projects."
>
  <section class="section gallery-intro shell" aria-labelledby="gallery-title">
    <p class="gallery-kicker">Concept gallery</p>
    <h1 id="gallery-title">Characters of the forge.</h1>
    <p class="lede">Meet Rei Ai, Orihime, Hikari, and Shiori through four early illustrations from the forge's projects.</p>
  </section>

  <section class="section gallery-content shell" aria-labelledby="gallery-filter-title">
    <form hidden class="gallery-filters" id="gallery-filters" aria-labelledby="gallery-filter-title">
      <div class="section-heading">
        <h2 id="gallery-filter-title">Filter references.</h2>
        <button class="gallery-reset" type="reset">Reset filters</button>
      </div>
      <div class="gallery-filter-grid">
        {controls.map((control) => (
          <label class="gallery-filter" for={`gallery-${control.name}`}>
            <span>{control.label}</span>
            <select id={`gallery-${control.name}`} name={control.name}>
              <option value="all">All</option>
              {control.options.map((option) => <option value={option.value}>{option.label}</option>)}
            </select>
          </label>
        ))}
      </div>
    </form>
    <p class="gallery-no-js" id="gallery-no-js">Filtering is unavailable without JavaScript; all {recordCount} records remain visible.</p>

    <div class="gallery-results" role="region" aria-labelledby="gallery-results-title">
      <h2 class="gallery-results-heading" id="gallery-results-title">Results</h2>
      <p class="gallery-filter-status" id="gallery-filter-status" role="status" aria-live="polite">Showing all {recordCount} records.</p>
      <div class="gallery-grid" id="gallery-grid">
        {galleryRecords.map((record) => {
          const facets = galleryFacetValues(record);
          return (
            <article
              class="gallery-card"
              data-character={facets.character}
              data-project={facets.project}
              data-genre={facets.genre.join('|')}
              data-style-revision={facets.styleRevision}
              data-status={facets.status}
              data-date={facets.date.join('|')}
              data-process={facets.process}
            >
              <figure class="gallery-card-figure">
                <img
                  class="gallery-card-image"
                  src={record.displayPath}
                  width={record.derivative.width}
                  height={record.derivative.height}
                  decoding="async"
                  loading="lazy"
                  alt={`${record.displayName}, ${record.approvedFacts.slice(0, 3).join(', ')}.`}
                />
                <figcaption>
                  <strong>{record.displayName}</strong>
                  <span>{labelFor(record.projectId)}</span>
                </figcaption>
              </figure>
              <div class="gallery-card-body">
                <h3>{record.displayName}</h3>
                <p class="gallery-concept-label">Historical concept</p>
                <p class="gallery-project">{labelFor(record.projectId)}</p>
                <p class="gallery-caption">{record.briefCaption}</p>
                <details class="gallery-details">
                  <summary>Source and process</summary>
                  <dl class="gallery-meta">
                    <div><dt>Process</dt><dd>{labelFor(record.process)}</dd></div>
                    <div><dt>Style revision</dt><dd>Not recorded</dd></div>
                    <div><dt>Style reference</dt><dd>Current reference for style</dd></div>
                    <div><dt>Genre basis</dt><dd>{genreBasisLabel(record.genreBasis)}</dd></div>
                    <div><dt>Status</dt><dd>{labelFor(record.status)}</dd></div>
                    <div><dt>Registry record date</dt><dd>{record.date.registryRecorded}</dd></div>
                    <div><dt>Source date</dt><dd>{record.date.source ?? 'Not recorded in this gallery'}</dd></div>
                    <div><dt>Conversion date</dt><dd>{record.date.conversion ?? 'Not recorded in this gallery'}</dd></div>
                    <div><dt>Authoring tool</dt><dd>{record.authoringTool ?? 'Not recorded'}</dd></div>
                    <div><dt>Provider</dt><dd>{record.provider ?? 'Not recorded'}</dd></div>
                    <div><dt>Model</dt><dd>{record.model ?? 'Not recorded'}</dd></div>
                    <div><dt>Display scope</dt><dd>{record.terms.displayScope}</dd></div>
                    <div><dt>Third-party reuse</dt><dd>{record.terms.thirdPartyReuse}</dd></div>
                    <div><dt>Source terms</dt><dd>{record.terms.sourceSummary}</dd></div>
                    <div><dt>Attribution</dt><dd>{record.attribution}</dd></div>
                    <div><dt>Source Git blob SHA-1</dt><dd>{record.sourceIdentity.blobSha}</dd></div>
                    <div><dt>Source bytes SHA-256</dt><dd>{record.sourceIdentity.sourceBytesSha256}</dd></div>
                    <div><dt>Derivative SHA-256</dt><dd>{record.derivative.sha256}</dd></div>
                    <div><dt>Byte identity</dt><dd>{record.sourceIdentity.sourceBytesMatchDerivative ? 'Matches pinned source bytes' : 'Differs from pinned source bytes'}</dd></div>
                    <div><dt>Source path</dt><dd>{record.sourceIdentity.path}</dd></div>
                    <div><dt>Source revision</dt><dd>{record.sourceIdentity.revision}</dd></div>
                    <div><dt>Approved facts</dt><dd><ul>{record.approvedFacts.map((fact) => <li>{fact}</li>)}</ul></dd></div>
                    <div><dt>Known unknowns</dt><dd><ul>{record.explicitUnknowns.map((unknown) => <li>{unknown}</li>)}</ul></dd></div>
                  </dl>
                  <a class="text-link" href={record.terms.sourceUrl}>{record.terms.sourceLinkLabel} <span aria-hidden="true">↗</span></a>
                  <a class="text-link" href={record.sourceIdentity.blobUrl}>Pinned source identity <span aria-hidden="true">↗</span></a>
                </details>
              </div>
            </article>
          );
        })}
      </div>
      <p class="gallery-empty" id="gallery-empty" hidden>No illustrations match these filters. <button type="button" data-reset-filters>Reset filters</button></p>
    </div>

    <script is:inline>
      const form = document.querySelector('#gallery-filters');
      const cards = Array.from(document.querySelectorAll('.gallery-card'));
      const status = document.querySelector('#gallery-filter-status');
      const empty = document.querySelector('#gallery-empty');
      const noJs = document.querySelector('#gallery-no-js');
      const values = (card, key) => (card.dataset[key] ?? '').split('|');
      const applyFilters = () => {
        if (!form) return;
        const selected = Object.fromEntries(new FormData(form).entries());
        let visible = 0;
        cards.forEach((card) => {
          const matches = Object.entries(selected).every(([key, value]) => value === 'all' || values(card, key).includes(value));
          card.hidden = !matches;
          if (matches) visible += 1;
        });
        if (status) status.textContent = `${visible} of ${cards.length} records shown.`;
        if (empty) empty.hidden = visible !== 0;
      };
      if (form) form.hidden = false;
      if (noJs) noJs.hidden = true;
      form?.addEventListener('change', applyFilters);
      form?.addEventListener('reset', () => requestAnimationFrame(applyFilters));
      document.querySelector('[data-reset-filters]')?.addEventListener('click', () => {
        form?.reset();
        applyFilters();
        document.getElementById('gallery-character')?.focus();
      });
      applyFilters();
    </script>
  </section>
</Site>
